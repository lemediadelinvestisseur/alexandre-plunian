interface Props { name: keyof typeof ICONS | string; class?: string }
const { name, class: cls } = Astro.props;
const icon = ICONS[name];
---
{icon && (
  <svg
    class={cls}
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill={icon.fill ? 'currentColor' : 'none'}
    stroke={icon.fill ? undefined : 'currentColor'}
    stroke-width={icon.fill ? undefined : 1.8}
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icon.d}
  />
)}
