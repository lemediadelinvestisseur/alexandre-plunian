---
// Shows public/portrait.jpg (in grayscale) if it exists, otherwise the initials.
import { existsSync } from 'node:fs';
import { SITE } from '../config';

const hasPhoto = existsSync('public/portrait.jpg');
---
<div class="portrait">
  {hasPhoto ? <img src="/portrait.jpg" alt={SITE.name} width="72" height="72" /> : <span aria-hidden="true">AP</span>}
</div>
