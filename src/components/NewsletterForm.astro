---
// Inscription à la newsletter : envoyée à /api/lead (type « newsletter ») qui l'ajoute à la liste Brevo.
---
<form class="newsletter-form" data-lead-form="newsletter" novalidate>
  <label class="sr-only" for="nl-email">Adresse e-mail</label>
  <input id="nl-email" name="email" type="email" autocomplete="email" placeholder="votre@email.fr" required />
  <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button class="pill" type="submit">Je m'inscris</button>
</form>
<p class="newsletter-msg" role="status" aria-live="polite"></p>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-lead-form="newsletter"]').forEach((form) => {
    const msg = form.nextElementSibling as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = 'Entrez une adresse e-mail valide.';
        return;
      }
      const button = form.querySelector('button')!;
      button.disabled = true;
      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'newsletter', email, website: (form.elements.namedItem('website') as HTMLInputElement).value }),
        });
        if (!res.ok) throw new Error();
        form.reset();
        msg.textContent = 'Inscription enregistrée. À bientôt dans votre boîte mail.';
      } catch {
        msg.textContent = "L'inscription n'a pas abouti. Réessayez dans un instant.";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
