---
import type { Publication } from '../lib/feed';
import { formatDate } from '../lib/feed';

interface Props { post: Publication }
const { post } = Astro.props;
const tone = post.source === 'video' ? 'video' : /bourse|etf/i.test(post.category ?? '') ? 'bourse' : /avis/i.test(post.category ?? '') ? 'avis' : 'epargne';
---
<a class="post" href={post.url} target="_blank" rel="noopener" data-source={post.source}>
  <div
    class:list={['post-cover', tone, { 'has-img': post.image }]}
    style={post.image ? `background-image:url('${post.image}')` : undefined}
  >
    <span class="cat">{post.source === 'video' ? 'VIDÉO' : (post.category ?? 'ARTICLE').toUpperCase()}</span>
  </div>
  <div class="post-body">
    <h3>{post.title}</h3>
    {post.excerpt && <p>{post.excerpt}</p>}
    <time datetime={post.date}>{formatDate(post.date).toUpperCase()}</time>
  </div>
</a>
