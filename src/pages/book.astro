---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { CLIENTS } from '../data/clients';

const OFFER_LABEL = { media: 'Média', agency: 'Agence' } as const;
const sorted = [...CLIENTS].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
---
<Base title="Références" description="Les marques et entreprises accompagnées par Alexandre Plunian : partenariats média et production de contenu.">
  <div class="wrap">
    <div class="intro">
      <h1>Références.</h1>
      <p class="lead">Les marques accompagnées avec le Média de l'investisseur et l'agence de contenu.</p>
    </div>

    {sorted.length === 0 ? (
      <section class="block">
        <h2>Book</h2>
        <div>
          <p>Le book complet, avec les marques et des exemples de contenus réalisés, est envoyé sur demande.</p>
          <div class="actions"><a class="button" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Demande de book')}`}>Recevoir le book</a></div>
        </div>
      </section>
    ) : (
      sorted.map((c) => (
        <section class="block">
          <h2>{c.year ?? c.sector}</h2>
          <div class="item">
            <h3>{c.name}<span class="tag">{c.sector} · {c.offer.map((o) => OFFER_LABEL[o]).join(', ')}</span></h3>
            {c.summary && <p>{c.summary}</p>}
            <ul>{c.deliverables.map((d) => <li>{d}</li>)}</ul>
            {c.results && c.results.length > 0 && (
              <div class="figures">{c.results.map((r) => <div><b>{r.value}</b><span>{r.label}</span></div>)}</div>
            )}
            {c.url && <div class="actions"><a class="link arrow-out" href={c.url} target="_blank" rel="noopener">Voir le contenu</a></div>}
          </div>
        </section>
      ))
    )}
  </div>
</Base>
