---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page introuvable">
  <div class="wrap page-hero" style="padding-bottom: 96px">
    <p class="eyebrow">Erreur 404</p>
    <h1>Cette page <em>n'existe pas.</em></h1>
    <p class="lead">Le lien est peut-être ancien ou mal recopié.</p>
    <div class="actions"><a class="pill primary" href="/">Retour à l'accueil <Icon name="arrow" /></a></div>
  </div>
</Base>
