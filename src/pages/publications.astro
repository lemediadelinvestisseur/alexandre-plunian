---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPublications } from '../lib/feed';

const all = await getPublications();
// Filters: categories present in the feed, from most to least populated
const counts = new Map<string, number>();
for (const p of all) if (p.category) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([c]) => c);
const PAGE = 30;
---
<Base title="Publications" description="Tous les articles du Média de l'investisseur et toutes les vidéos YouTube d'Alexandre Plunian, en un seul endroit.">
  <div class="wrap">
    <div class="intro">
      <h1>Publications.</h1>
      <p class="lead">Les articles du Média de l'investisseur et mes vidéos YouTube. {all.length} à ce jour, mis à jour chaque jour. <a href="/rss.xml">Flux RSS</a></p>
    </div>

    <div class="filters" role="group" aria-label="Filtrer par rubrique">
      <button type="button" aria-pressed="true" data-filter="">Tout</button>
      {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
    </div>
    <div class="rows post-list" data-page={PAGE}>
      {all.map((p, i) => (
        <div data-category={p.category ?? ''} hidden={i >= PAGE}><PostRow post={p} /></div>
      ))}
    </div>
    <button class="load-more arrow" type="button" hidden={all.length <= PAGE}>Afficher plus</button>
  </div>
</Base>
<style>
  /* Ruled list: every visible row has a top rule, so filtering never leaves a gap */
  .post-list { border-bottom: 1px solid var(--line); }
  .post-list > div { border-top: 1px solid var(--line) !important; }
  .post-list .row { padding-top: 12px !important; }
</style>
<script>
  const list = document.querySelector<HTMLElement>('.post-list')!;
  const items = [...list.children] as HTMLElement[];
  const more = document.querySelector<HTMLButtonElement>('.load-more')!;
  const step = Number(list.dataset.page);
  let filter = '';
  let shown = step;

  function render() {
    const matching = items.filter((el) => !filter || el.dataset.category === filter);
    items.forEach((el) => (el.hidden = true));
    matching.slice(0, shown).forEach((el) => (el.hidden = false));
    more.hidden = matching.length <= shown;
  }

  document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.filters button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      filter = b.dataset.filter ?? '';
      shown = step;
      render();
    }),
  );
  more.addEventListener('click', () => {
    shown += step;
    render();
  });
</script>
