---
import Base from '../layouts/Base.astro';
import { SITE, whatsappLink } from '../config';
const wa = whatsappLink();
---
<Base title="Contact" description="Proposer un partenariat média, un projet d'agence ou une intervention à Alexandre Plunian.">
  <div class="wrap">
    <div class="intro">
      <h1>Contact.</h1>
      <p class="lead">Partenariat, projet de contenu ou intervention : quelques lignes suffisent. Réponse sous 48 h ouvrées.</p>
    </div>

    <section class="block">
      <h2>Écrire</h2>
      <div>
        <ul class="rows">
          <li><a class="row" href={`mailto:${SITE.email}`}><span class="title">{SITE.email}</span><span class="meta">E-mail</span></a></li>
          {wa && <li><a class="row" href={wa} target="_blank" rel="noopener"><span class="title arrow-out">WhatsApp</span><span class="meta">Réponse rapide</span></a></li>}
        </ul>
      </div>
    </section>

    <section class="block">
      <h2>Ailleurs</h2>
      <div>
        <ul class="rows">
          <li><a class="row" href={SITE.socials.x} target="_blank" rel="noopener"><span class="title arrow-out">X</span><span class="meta">@le_investisseur</span></a></li>
          <li><a class="row" href={SITE.socials.linkedin} target="_blank" rel="noopener"><span class="title arrow-out">LinkedIn</span><span class="meta">plunianalexandre</span></a></li>
          <li><a class="row" href={SITE.socials.youtube} target="_blank" rel="noopener"><span class="title arrow-out">YouTube</span><span class="meta">@alexandreplunian</span></a></li>
        </ul>
      </div>
    </section>
  </div>
</Base>
