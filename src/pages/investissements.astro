---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPublications } from '../lib/feed';

const all = await getPublications();
const pick = (re: RegExp) => all.filter((p) => re.test(p.category ?? '')).slice(0, 3);
const PILLARS = [
  {
    title: 'Immobilier',
    text: "L'immobilier apporte des revenus réguliers et un effet de levier grâce au crédit. Je regarde d'abord le rendement net, la fiscalité et la qualité de l'emplacement, puis les SCPI pour diversifier sans gestion.",
    posts: pick(/immobilier/i),
  },
  {
    title: 'Bourse',
    text: "Le cœur du patrimoine sur le long terme : des ETF larges et peu chers, logés dans les bonnes enveloppes (PEA, assurance vie, CTO), complétés par quelques actions à dividendes.",
    posts: pick(/bourse/i),
  },
  {
    title: 'Cryptomonnaies',
    text: "Une poche de conviction, dimensionnée pour accepter la volatilité. Bitcoin et Ethereum en priorité, et une veille suivie de l'écosystème avant tout autre projet.",
    posts: pick(/crypto/i),
  },
];
---
<Base title="Investissements" description="Ma méthode d'investissement en immobilier, bourse et cryptomonnaies, et les guides du Média de l'investisseur pour chaque univers.">
  <div class="wrap">
    <div class="intro">
      <h1>Trois classes d'actifs, une méthode.</h1>
      <p class="lead">J'investis depuis 2019. Des choix expliqués, des chiffres vérifiables, aucune promesse de gain.</p>
    </div>

    {PILLARS.map((p) => (
      <section class="block">
        <h2>{p.title}</h2>
        <div>
          <p>{p.text}</p>
          {p.posts.length > 0 && <div class="rows">{p.posts.map((post) => <PostRow post={post} />)}</div>}
        </div>
      </section>
    ))}

    <section class="block">
      <h2>Avertissement</h2>
      <div>
        <p class="muted">Investir comporte un risque de perte en capital. Les contenus de ce site et du Média de l'investisseur sont pédagogiques et ne constituent pas un conseil en investissement personnalisé. Les performances passées ne préjugent pas des performances futures.</p>
      </div>
    </section>
  </div>
</Base>
