---
import Base from '../layouts/Base.astro';
import Offers from '../components/Offers.astro';
import Process from '../components/Process.astro';
import { AGENCY_OFFERS } from '../data/offers';
import { SITE, whatsappLink } from '../config';
const wa = whatsappLink("Bonjour Alexandre, j'aimerais parler d'un projet de contenu avec votre agence.");
---
<Base title="Agence de contenu" description="Gestion des réseaux sociaux, rédaction d'articles SEO, stratégie de contenu et vidéos courtes pour les acteurs de la finance.">
  <div class="wrap">
    <div class="intro">
      <h1>Le savoir-faire du média, pour votre marque.</h1>
      <p class="lead">Nous produisons pour vous ce que nous faisons chaque jour pour le média : du contenu finance clair, juste et bien référencé. Pour les fintechs, courtiers, plateformes d'investissement et conseillers.</p>
      <div class="actions">
        <a class="button" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Projet de contenu')}`}>Parler de votre projet</a>
        {wa && <a class="link" href={wa} target="_blank" rel="noopener">WhatsApp</a>}
      </div>
    </div>

    <section class="block">
      <h2>Services</h2>
      <div><Offers offers={AGENCY_OFFERS} detailed /></div>
    </section>

    <section class="block">
      <h2>Pourquoi nous</h2>
      <div class="items">
        <div class="item"><h3>Nous connaissons le sujet</h3><p>Nous écrivons sur l'investissement chaque semaine. Rien à réexpliquer.</p></div>
        <div class="item"><h3>Nous écrivons pour Google</h3><p>Les méthodes qui font venir les lecteurs du média sont appliquées à votre site.</p></div>
        <div class="item"><h3>Nous respectons les règles</h3><p>Pas de promesse de gain, des risques mentionnés : un contenu que votre conformité peut valider.</p></div>
      </div>
    </section>

    <section class="block">
      <h2>Déroulé</h2>
      <div><Process /></div>
    </section>
  </div>
</Base>
