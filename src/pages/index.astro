---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import PostRow from '../components/PostRow.astro';
import Figures from '../components/Figures.astro';
import { AUDIENCE, AUDIENCE_SOURCE } from '../data/audience';
import { SITE, whatsappLink } from '../config';
import { CLIENTS } from '../data/clients';
import { getPublications } from '../lib/feed';

const latest = (await getPublications()).slice(0, 6);
const wa = whatsappLink();
---
<Base>
  <div class="wrap">
    <div class="intro">
      <Portrait />
      <h1>Alexandre Plunian, fondateur du Média de l'investisseur et 21m².</h1>
      <p class="lead">J'investis depuis 7 ans et j'aide les Français à faire de même.</p>
    </div>

    <section class="block">
      <h2>Aujourd'hui</h2>
      <div>
        <ul class="rows">
          <li><a class="row" href={SITE.media.url} target="_blank" rel="noopener"><span class="title arrow-out">{SITE.media.name}</span><span class="meta">Fondateur</span></a></li>
          <li><a class="row" href={SITE.socials.youtube} target="_blank" rel="noopener"><span class="title arrow-out">Chaîne YouTube</span><span class="meta">Créateur</span></a></li>
          <li><div class="row"><span class="title">21m²</span><span class="meta">Fondateur</span></div></li>
          <li><a class="row" href="/agence"><span class="title">Agence de contenu</span><span class="meta">Fondateur</span></a></li>
          <li><a class="row" href="/investissements"><span class="title">Investissements personnels</span><span class="meta">Depuis 2019</span></a></li>
        </ul>
      </div>
    </section>

    <section class="block">
      <h2>Audience</h2>
      <div>
        <Figures figures={AUDIENCE} />
        <p class="source">{AUDIENCE_SOURCE}</p>
      </div>
    </section>

    <section class="block">
      <h2>Travailler ensemble</h2>
      <div>
        <p>Je travaille avec un nombre limité de marques : fintechs, courtiers, plateformes d'investissement. Uniquement celles que je peux présenter honnêtement.</p>
        <ul class="rows">
          <li><a class="row" href="/media"><span class="title">Partenariats média</span><span class="meta">Vidéo, articles, comparatifs</span></a></li>
          <li><a class="row" href="/agence"><span class="title">Production de contenu</span><span class="meta">Réseaux, SEO, stratégie</span></a></li>
          {CLIENTS.length > 0 && <li><a class="row" href="/book"><span class="title">Références</span><span class="meta">{CLIENTS.length} marques</span></a></li>}
        </ul>
      </div>
    </section>

    <section class="block">
      <h2>Publications</h2>
      <div>
        <div class="rows">{latest.map((p) => <PostRow post={p} />)}</div>
        <div class="actions"><a class="link arrow" href="/publications">Toutes les publications</a></div>
      </div>
    </section>

    <section class="block">
      <h2>Contact</h2>
      <div>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a>{wa && <> · <a href={wa} target="_blank" rel="noopener">WhatsApp</a></>}</p>
      </div>
    </section>
  </div>
</Base>
