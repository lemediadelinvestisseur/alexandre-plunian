---
import Base from '../layouts/Base.astro';
import Offers from '../components/Offers.astro';
import Process from '../components/Process.astro';
import Figures from '../components/Figures.astro';
import { AUDIENCE, AUDIENCE_SOURCE, RESULTS, PARTNERS } from '../data/audience';
import { MEDIA_OFFERS } from '../data/offers';
import { SITE, whatsappLink } from '../config';
const wa = whatsappLink("Bonjour Alexandre, je souhaite recevoir le kit média du Média de l'investisseur.");
---
<Base title="Partenariats média" description="Faites connaître votre produit financier auprès d'épargnants actifs : vidéos YouTube, articles avis et test, comparatifs et newsletter.">
  <div class="wrap">
    <div class="intro">
      <h1>Une audience qui investit vraiment.</h1>
      <p class="lead">{SITE.media.name} et ma chaîne YouTube s'adressent à des épargnants qui comparent, se renseignent et passent à l'action. Je ne travaille qu'avec des partenaires que je peux présenter honnêtement.</p>
      <div class="actions">
        <a class="button" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Kit média')}`}>Demander le kit média</a>
        {wa && <a class="link" href={wa} target="_blank" rel="noopener">WhatsApp</a>}
      </div>
    </div>

    <section class="block">
      <h2>Audience</h2>
      <div>
        <Figures figures={AUDIENCE} />
        <p class="source">{AUDIENCE_SOURCE}</p>
      </div>
    </section>

    <section class="block">
      <h2>Résultats</h2>
      <div>
        <Figures figures={RESULTS} />
        <p class="source">Partenaires : {PARTNERS.join(', ')}.</p>
      </div>
    </section>

    <section class="block">
      <h2>Formats</h2>
      <div><Offers offers={MEDIA_OFFERS} detailed /></div>
    </section>

    <section class="block">
      <h2>Pourquoi le média</h2>
      <div class="items">
        <div class="item"><h3>Des lecteurs en phase de choix</h3><p>Les guides et comparatifs sont lus par des personnes qui s'apprêtent à ouvrir un compte ou à souscrire.</p></div>
        <div class="item"><h3>Un contenu qui dure</h3><p>Les articles sont référencés sur Google et mis à jour : la visibilité continue après la publication.</p></div>
        <div class="item"><h3>Une parole indépendante</h3><p>Chaque partenariat est signalé. C'est ce qui rend la recommandation crédible.</p></div>
      </div>
    </section>

    <section class="block">
      <h2>Déroulé</h2>
      <div><Process /></div>
    </section>
  </div>
</Base>
