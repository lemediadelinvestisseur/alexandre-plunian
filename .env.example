# Copy to .env for local development. In production, these values are set in
# .github/workflows/deploy.yml, and the Ghost key is a GitHub secret.
# Never commit the real .env.

# Public site URL (sitemap, RSS feed, social sharing tags)
SITE_URL=https://alexandre-plunian.com

# ── Publications feed (read at build time) ──
# Ghost Content API key (read-only): Ghost → Settings → Integrations → Add custom integration
GHOST_URL=https://lemediadelinvestisseur.ghost.io
GHOST_CONTENT_API_KEY=
# YouTube channel ID (starts with UC…): YouTube Studio → Settings → Channel → Advanced settings
YOUTUBE_CHANNEL_ID=UChjInilqnxyx9PhYxcC5o9w
