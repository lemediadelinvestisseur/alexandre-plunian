# Copier en .env pour le développement local. En production, à définir dans Netlify
# (Site configuration → Environment variables). Ne jamais committer le vrai .env.

# Adresse publique du site (sitemap, flux RSS, balises de partage)
SITE_URL=https://alexandre-plunian.com

# ── Brevo (CRM et e-mails) ──
# Clé API : Brevo → menu du compte → SMTP & API → Clés API
BREVO_API_KEY=
# Liste où ranger les demandes pro (Contacts → Listes → l'identifiant numérique)
BREVO_LEADS_LIST_ID=
# Liste de la newsletter
BREVO_NEWSLETTER_LIST_ID=
# Adresse qui reçoit l'alerte à chaque nouveau lead
LEAD_NOTIFY_EMAIL=lemediadelinvestisseur@gmail.com
# Expéditeur des alertes : doit être un expéditeur validé dans Brevo (Expéditeurs, domaines et IP dédiées)
BREVO_SENDER_EMAIL=
# « true » pour créer aussi une affaire (deal) dans le CRM Brevo à chaque demande pro
BREVO_CREATE_DEAL=true

# ── Flux de publications (lus au moment de la construction du site) ──
# Clé Content API de Ghost (lecture seule) : Ghost → Settings → Integrations → Add custom integration
GHOST_URL=https://lemediadelinvestisseur.fr
GHOST_CONTENT_API_KEY=
# Identifiant de la chaîne YouTube (commence par UC…) : YouTube Studio → Paramètres → Chaîne → Paramètres avancés
YOUTUBE_CHANNEL_ID=
